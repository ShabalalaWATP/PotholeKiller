{
  "name": "potholekiller",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:live": "node tests/live-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.1.0",
    "@netlify/identity": "^2.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.548.0",
    "next": "^16.0.1",
    "openai": "^6.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.0.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
